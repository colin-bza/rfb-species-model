FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale  0.001;

vertices
(
    // Channel to interface region
    // - the interface will be a region 0.2 mm above and below
    (0 0 0)       // 0
    (0.8 0 0)     // 1
    (0.8 0.8 0)     // 2
    (0 0.8 0)       // 3
    (0 0 50)      // 4
    (0.8 0 50)    // 5
    (0.8 0.8 50)    // 6
    (0 0.8 50)      // 7

    // Interface - channel side
    (1 0 0)     // 8
    (1.2 0 0)     // 9     
    (1.2 0.8 0)     // 10
    (1 0.8 0)     // 11
    

    // Interface - Electrode side
    (1 0 50)     // 12
    (1.2 0 50)    // 13
    (1.2 0.8 50)    // 14
    (1 0.8 50)     // 15 

    // Electrode below channel
    (4.02 0 0)     // 16
    (4.02 0.8 0)     // 17
    (4.02 0.8 50)    // 18
    (4.02 0 50)    // 19

 
    // Right electrode extension
    (1.2 1.3 0)     // 20
    (4.02 1.3 0)     // 21
    (4.02 1.3 50)     // 22
    (1.2 1.3 50)     // 23
    (1.0 1.3 0)     // 24
    (1.0 1.3 50)     // 25

    // Left electrode extension
    (1.2 -0.5 0)     // 26
    (4.02 -0.5 0)     // 27
    (4.02 -0.5 50)     // 28
    (1.2 -0.5 50)     // 29
    (1.0 -0.5 0)     // 30
    (1.0 -0.5 50)     // 31
);

blocks
(
    // 1-Channel
    hex (0 1 2 3 4 5 6 7) (8 8 500) simpleGrading (1 1 1)
    
    // 2- Interface - channel side
    hex (1 8 11 2 5 12 15 6) (8 8 500) simpleGrading (0.25 1 1)

    // 3- Interface - electrode side, below channel region
    hex (8 9 10 11 12 13 14 15) (8 8 500) simpleGrading (4 1 1)
    
    // 4 - Electrode below channel uniform
    hex (9 16 17 10 13 19 18 14) (28 8 500) simpleGrading (1 1 1)

    // 5 - Electrode left
    hex (30 26 9 8 31 29 13 12) (8 5 500) simpleGrading (4 1 1)
    hex (26 27 16 9 29 28 19 13) (28 5 500) simpleGrading (1 1 1)

    // Electrode right
    hex (11 10 20 24 15 14 23 25) (8 5 500) simpleGrading (4 1 1)
    hex (10 17 21 20 14 18 22 23) (28 5 500) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 1 2 3)
            (1 8 11 2)
	);

    }

    // Electrode inlet wall
    e_in_wall
    {
        type wall;
        faces
        (
            (26 27 16 9)
            (9 16 17 10)
            (10 17 21 20)
            (30 26 9 8)
            (8 9 10 11)
            (11 10 20 24)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (4 5 6 7)
            (5 12 15 6)
        );
    }

    // Electrode outlet wall
    e_out_wall
    {
	type wall;
	faces
	(
	    (29 28 19 13)
        (13 19 18 14)
        (14 18 22 23)
        (31 29 13 12)
        (12 13 14 15)
        (15 14 23 25)
	);
    }

    top
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (30 31 12 8)
            (11 15 25 24)
        );
    }

    bottom
    {
        type wall;
        faces
        (
	    // Membrane. Interface to be treated as defaultface
            (27 16 19 28)
            (16 17 18 19)
            (17 21 22 18)
        );
    }

    back
    {
        type wall;
        faces
        (
	    // Channel front at Y+
            (0 1 5 4)
            (1 8 12 5)
        );
    }

    // Channel back in Y-
    front
    {
        type wall;
        faces
        (
	    (3 7 6 2)
        (2 6 15 11)
        );
    }

    // Transverse flow outlet towards
    // the remaining of the electrode 
    elec_left
    {
        type cyclic;
        faces
    (
        (26 27 28 29)
        (30 26 29 31)
    );
    neighbourPatch elec_right;
    }

    elec_right
    {
        type cyclic;
        faces
    (
        (23 22 21 20)
        (25 23 20 24)
    );
    neighbourPatch elec_left;
    }
);

