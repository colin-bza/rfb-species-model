FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// V4/V5 electrolyte kinematic viscosity (mu 0.0036 Pa s, rho 1350 kg m^-3)
nu              2.67e-6; 

// Diffusivity of binary pair, to be found 
D               3e-10; // m^2/s

// Turbulent Schmidt number
Sct             0.85;
