FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     brinkmanPisoFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         80; // for base scenario

deltaT          1e-8;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep	yes;

maxDeltaT       1.5e-4;

maxCo           0.25;



