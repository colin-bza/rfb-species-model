FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     brinkmanPisoFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1;

// Variable time-steps do not work
deltaT          5e-6;

writeControl    runTime;// adjustable;// 

writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep	no;

maxDeltaT       1e-4;

maxCo           0.05;



