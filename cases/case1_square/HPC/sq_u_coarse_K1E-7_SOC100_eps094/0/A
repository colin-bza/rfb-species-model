FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      A;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        // Pure reactant
        type            fixedValue;
        value           uniform 0.0496; // 100%SOC V4
    }

    outlet
    {
        // Open boundary
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }


    top
    {
        // Impermeable boundary
        type              zeroGradient;
    }

    bottom
    {
        // Impermeable boundary
        type              zeroGradient;
    }

    front
    {
        // Impermeable boundary
        type              zeroGradient;
    }

    back
    {
        // Impermeable boundary
        type              zeroGradient;
    }
    // Electrode inlet, no flow
    e_in_wall
    {
        type            zeroGradient;
    }
    // Electrode outlet, no flow
    e_out_wall
    {
        type            zeroGradient;
    }

    // Transverse flow
    elec_left
    {
        type            cyclic;
    }

    elec_right
    {
        type            cyclic;
    }
}


