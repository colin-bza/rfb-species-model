mpirun -np 14 brinkmanPisoFoam -parallel > log.brinkmanPisoFoam

# -------------------- SIMULACIÓN 2 --------------------
editControlDict "1" "2e-3" "no" "0.5" "1" "0.1"
mpirun -np 14 soloSpeciesFoam -parallel > log.soloSpeciesFoam


editControlDict "60" "2e-3" "no" "0.5" "1" "1"
mpirun -np 14 soloSpeciesFoam -parallel > log.soloSpeciesFoam

reconstructPar -constant | tee -a log.reconstructPar
rm -rf processor*
