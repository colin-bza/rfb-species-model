#!/bin/sh
cd ${0%/*} || exit 1                        # Run from this directory
. $WM_PROJECT_DIR/bin/tools/RunFunctions    # Tutorial run functions

# Función para editar el controlDict y fvSolution
editControlDict() {
    local endTime="$1"
    local deltaT="$2"
    local adjust="$3"
    local maxCo="$4"
    local maxDeltaT="$5"
    local writeInterval="$6"

    echo "Adjust parameters:"
    echo "  endTime         = $endTime"
    echo "  deltaT          = $deltaT"
    echo "  adjustTimeStep  = $adjust"
    echo "  maxCo           = $maxCo"
    echo "  maxDeltaT       = $maxDeltaT"
    echo "  writeInterval   = $writeInterval"

    # Modificar parámetros en controlDict
    sed -i -E "s/^\s*endTime\s+.*;/    endTime        $endTime;/" system/controlDict
    sed -i -E "s/^\s*deltaT\s+.*;/    deltaT          $deltaT;/" system/controlDict
    sed -i -E "s/^\s*adjustTimeStep\s+.*;/    adjustTimeStep $adjust;/" system/controlDict

    # Modificar o insertar writeInterval después de writeControl
    if grep -q "^\s*writeInterval\s" system/controlDict; then
        sed -i -E "s/^\s*writeInterval\s+.*;/    writeInterval   $writeInterval;/" system/controlDict
    else
        sed -i "/^\s*writeControl\s/ a\    writeInterval   $writeInterval;" system/controlDict
    fi

    # Asegurarse de que startFrom = latestTime
    if grep -q "^\s*startFrom\s" system/controlDict; then
        sed -i -E "s/^\s*startFrom\s+.*;/    startFrom       latestTime;/" system/controlDict
    else
        sed -i "/^\s*startTime\s/ i\    startFrom       latestTime;" system/controlDict
    fi

    # Modificar o insertar maxCo y maxDeltaT en fvSolution
    if grep -q "^\s*maxCo\s" system/fvSolution; then
        sed -i -E "s/^\s*maxCo\s+.*;/    maxCo           $maxCo;/" system/fvSolution
    else
        echo "    maxCo           $maxCo;" >> system/fvSolution
    fi

    if grep -q "^\s*maxDeltaT\s" system/fvSolution; then
        sed -i -E "s/^\s*maxDeltaT\s+.*;/    maxDeltaT       $maxDeltaT;/" system/fvSolution
    else
        echo "    maxDeltaT       $maxDeltaT;" >> system/fvSolution
    fi
}

# -------------------- SIMULACIÓN 1 --------------------
editControlDict "0.1" "1e-8" "yes" "0.5" "5e-5" "0.002"

runApplication blockMesh | tee -a log.blockMesh
runApplication topoSet | tee -a log.topoSet
